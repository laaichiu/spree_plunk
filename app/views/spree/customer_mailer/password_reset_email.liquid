---
subject: "Reset your {{ store.name }} password"
---
{% assign name = customer.first_name | default: customer.email %}
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">Reset your password</mj-text>
    <mj-text mj-class="greeting">Hi {{ name }},</mj-text>
    <mj-text mj-class="lead">Use the secure link below to reset your {{ store.name }} password.</mj-text>
    <mj-button href="{{ reset_url }}">Reset password</mj-button>
    <mj-text mj-class="note">You can ignore this email if you did not request a password reset.</mj-text>
  </mj-column>
</mj-section>
