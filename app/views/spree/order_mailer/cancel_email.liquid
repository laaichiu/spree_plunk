---
subject: "Order #{{ order.number }} from {{ store.name }} was canceled"
---
<mj-section>
  <mj-column css-class="hero">
    <mj-text mj-class="heading">Your order was canceled</mj-text>
    <mj-text mj-class="greeting">Hi {{ order.customer_name }},</mj-text>
    <mj-text mj-class="lead">Order #{{ order.number }} has been canceled. Contact us if you have any questions.</mj-text>
  </mj-column>
</mj-section>
<mj-section padding="32px 0 0">
  <mj-column>
    <mj-text mj-class="section-heading" padding="0 0 16px">Canceled items</mj-text>
    {% for item in order.items %}
      <mj-text align="left" padding="8px 0">{{ item.name }}{% if item.options_text != blank %} — {{ item.options_text }}{% endif %}<br />{{ item.quantity }} × {{ item.price | money }} <span style="float:right">{{ item.amount | money }}</span></mj-text>
    {% endfor %}
  </mj-column>
</mj-section>
